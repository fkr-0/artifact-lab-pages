{
  "schemaVersion": "artifacts.fkr.dev/v1",
  "id": "bathroom-emergency-guide",
  "version": "5.1.2",
  "title": "Bathroom Emergency Guide",
  "description": "Independent submodule-sourced, print-first decision guide with an accessible static site, master editions, and eleven standalone route books.",
  "kind": "document",
  "status": "experimental",
  "required": false,
  "tags": ["accessibility", "decision-guide", "document", "offline", "print", "submodule"],
  "source": {
    "kind": "project",
    "path": "bathroom-emergency-guide",
    "git": {
      "mode": "submodule",
      "repository": "https://github.com/fkr-0/bathroom-emergency.git",
      "revision": "6d3ae5eba0f691059ef0db53287b1d9539486fd8"
    }
  },
  "build": {
    "mode": "compile",
    "cwd": "bathroom-emergency-guide",
    "command": ["npm", "run", "build"],
    "output": "build/site"
  },
  "release": {
    "kind": "directory",
    "entrypoint": "index.html",
    "path": "build/site",
    "offline": true
  },
  "launch": {
    "default": "newWindow",
    "modes": ["inline", "fullscreen", "newWindow"],
    "sandbox": "strict"
  },
  "verify": {
    "static": true,
    "standaloneSmoke": true,
    "expectedFiles": ["index.html"],
    "commands": [
      ["npm", "run", "build"],
      ["npm", "test"]
    ]
  }
}
