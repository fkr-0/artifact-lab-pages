{
  "schemaVersion": "artifacts.fkr.dev/v1",
  "id": "ethic-brawl",
  "version": "1.9.3",
  "title": "Ethic Brawl",
  "description": "Playable Ethic Brawl 1.9.3, compiled from the independently owned, immutable Git revision in the Artifact Lab submodule and published as a self-contained Pages runtime.",
  "kind": "application",
  "status": "active",
  "required": true,
  "tags": ["game", "project", "submodule"],
  "source": {
    "kind": "project",
    "path": "ethic-brawl",
    "git": {
      "mode": "submodule",
      "repository": "https://github.com/fkr-0/ethic-brawl.git",
      "revision": "9e53636e65831ecacc489f034f665e7afc79d152"
    }
  },
  "build": {
    "mode": "compile",
    "cwd": "ethic-brawl",
    "command": ["pnpm", "run", "build"],
    "output": "dist"
  },
  "release": {
    "kind": "directory",
    "entrypoint": "index.html",
    "path": "dist",
    "offline": true
  },
  "launch": {
    "default": "inline",
    "modes": ["inline", "fullscreen", "newWindow"],
    "sandbox": "trusted"
  }
}
