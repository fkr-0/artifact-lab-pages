{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artifacts.fkr.dev/schema/artifact-v1.json",
  "title": "Artifacts V12 manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "title", "kind", "source", "build", "release"],
  "properties": {
    "schemaVersion": { "const": "artifacts.fkr.dev/v1" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "version": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "kind": { "enum": ["application", "document", "download", "link", "text", "legacy"] },
    "status": { "enum": ["active", "experimental", "provisional", "legacy", "archived"], "default": "experimental" },
    "required": { "type": "boolean", "default": true },
    "tags": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "git"],
      "properties": {
        "kind": { "enum": ["file", "directory", "project", "external", "inline"] },
        "path": { "type": "string", "minLength": 1 },
        "entrypoint": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "minLength": 1 },
        "text": { "type": "string" },
        "format": { "enum": ["plain", "markdown"] },
        "git": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": { "enum": ["root", "submodule", "external", "none"] },
            "repository": { "type": "string" },
            "revision": { "type": "string" },
            "ignorePaths": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
          }
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["none", "assemble", "compile", "external"] },
        "renderer": { "enum": ["markdown-html", "copy", "html-inline"] },
        "cwd": { "type": "string" },
        "command": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "output": { "type": "string" },
        "provisionalShellCommand": { "type": "string" }
      }
    },
    "libraries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "delivery"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
          "version": { "type": "string", "minLength": 1 },
          "delivery": { "enum": ["inline", "vendor", "bundle"] },
          "target": { "type": "string" }
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["file", "directory", "download", "external", "inline"] },
        "entrypoint": { "type": "string" },
        "path": { "type": "string" },
        "url": { "type": "string" },
        "offline": { "type": "boolean" },
        "include": { "type": "array", "items": { "type": "string" } },
        "exclude": { "type": "array", "items": { "type": "string" } },
        "networkAllowlist": { "type": "array", "items": { "type": "string" } }
      }
    },
    "launch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default": { "enum": ["inline", "floating", "fullscreen", "newWindow", "download", "none"] },
        "modes": {
          "type": "array",
          "items": { "enum": ["inline", "floating", "fullscreen", "newWindow", "download", "none"] },
          "uniqueItems": true
        },
        "sandbox": { "enum": ["strict", "trusted", "none"] }
      }
    },
    "verify": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "static": { "type": "boolean" },
        "standaloneSmoke": { "type": "boolean" },
        "expectedFiles": { "type": "array", "items": { "type": "string" } },
        "commands": {
          "type": "array",
          "items": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
        }
      }
    },
    "legacy": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
