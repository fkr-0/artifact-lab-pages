#!/usr/bin/env bash
#
# artifacts-package - Create distributable tgz package from the V13 publication stage
#
# Usage: ./artifacts-package [output-dir]
#

set -euo pipefail

GREEN='\033[0;32m'
CYAN='\033[0;36m'
YELLOW='\033[1;33m'
NC='\033[0m'

ARTIFACTS_DIR="${ARTIFACTS_DIR:-/home/user/work/code/artifacts}"
PACKAGE_NAME="artifacts-collection"
OUTPUT_DIR="${1:-$ARTIFACTS_DIR}"
STAGE_ROOT="$(mktemp -d)"
STAGE="$STAGE_ROOT/$PACKAGE_NAME"
trap 'rm -rf "$STAGE_ROOT"' EXIT

SOURCE_DATE_EPOCH_VALUE="${SOURCE_DATE_EPOCH:-$(date -u +%s)}"
if VERSION_DATE=$(date -u -d "@${SOURCE_DATE_EPOCH_VALUE}" +%Y.%m.%d 2>/dev/null); then
  VERSION="$VERSION_DATE"
  PACKAGE_TIMESTAMP=$(date -u -d "@${SOURCE_DATE_EPOCH_VALUE}" +%Y-%m-%dT%H:%M:%SZ)
else
  VERSION=$(date -u +%Y.%m.%d)
  PACKAGE_TIMESTAMP=$(date -u +%Y-%m-%dT%H:%M:%SZ)
fi

echo -e "${CYAN}📦 Artifacts Collection - Manifest Packaging${NC}"
echo ""
echo -e "${CYAN}Materializing App Hub V13 publication stage...${NC}"
cd "$ARTIFACTS_DIR"
echo -e "${CYAN}Preparing pinned Revealive dependencies...${NC}"
pnpm --dir "$ARTIFACTS_DIR/revealive" install --frozen-lockfile
node scripts/build-publication-site.mjs --out "$STAGE" --no-build
node scripts/stage-compiled-publication.mjs --stage "$STAGE" --id revealive

cat > "$STAGE/VERSION" <<EOF_VERSION
$VERSION
Packaged: $PACKAGE_TIMESTAMP
Publication builder: scripts/build-publication-site.mjs
Legacy compatibility source: app-hub-v11/artifacts.source.json
EOF_VERSION
echo -e "${GREEN}  ✓${NC} VERSION"

cat > "$STAGE/README.md" <<'EOF_README'
# Artifacts Collection

Manifest-built static artifact collection.

## Quick Start

```bash
./artifacts-serve
```

Then open http://localhost:8080/ . The root `index.html` promotes App Hub V13.

## Build Model

`scripts/build-publication-site.mjs` composes the release stage from two layers:

- native `artifactctl` discovery/site assembly produces App Hub V13, its generated catalog, vendored bridge, and verified native releases;
- `app-hub-v11/artifacts.source.json` remains an explicit compatibility source for not-yet-migrated artifacts and stable legacy root URLs.

The package root is V13. V11 remains available at `app-hub-v11/` for compatibility. Generated deployment details are written to `BUILD_MANIFEST.json`, with `BUILD_MANIFEST.v13.json` and `BUILD_MANIFEST.v11.json` retaining layer receipts.
EOF_README
echo -e "${GREEN}  ✓${NC} README.md"

OUTPUT_FILE="$OUTPUT_DIR/${PACKAGE_NAME}-${VERSION}.tar.gz"
echo ""
echo -e "${CYAN}Creating package archive...${NC}"
mkdir -p "$OUTPUT_DIR"
cd "$STAGE_ROOT"
tar --sort=name --owner=0 --group=0 --numeric-owner --mtime="@${SOURCE_DATE_EPOCH_VALUE}" -cf - "$PACKAGE_NAME" | gzip -n > "$OUTPUT_FILE"

PACKAGE_SIZE=$(du -h "$OUTPUT_FILE" | cut -f1)
echo -e "${GREEN}✓ Package created:${NC} $OUTPUT_FILE"
echo -e "${GREEN}  Size:${NC} $PACKAGE_SIZE"

echo ""
echo -e "${CYAN}Creating checksums...${NC}"
cd "$OUTPUT_DIR"
sha256sum "${PACKAGE_NAME}-${VERSION}.tar.gz" > "${PACKAGE_NAME}-${VERSION}.tar.gz.sha256"
echo -e "${GREEN}✓ Checksum:${NC} ${PACKAGE_NAME}-${VERSION}.tar.gz.sha256"

echo ""
echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${CYAN}Package complete!${NC}"
echo -e "${GREEN}Package:${NC} $OUTPUT_FILE"
echo -e "${GREEN}Size:${NC}   $PACKAGE_SIZE"
echo -e "${GREEN}SHA256:${NC} $(cut -d' ' -f1 "${PACKAGE_NAME}-${VERSION}.tar.gz.sha256")"
