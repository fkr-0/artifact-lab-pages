{
  "kind": "meme-template",
  "version": 1,
  "title": "Classic two-caption meme template",
  "canvas": {
    "width": 1080,
    "height": 1080,
    "background": "#f8fafc",
    "transparent": false,
    "autoExpand": true,
    "allowNegative": true
  },
  "final": {
    "mode": "content-pad",
    "padding": 48,
    "border": 0,
    "borderColor": "#020617"
  },
  "watermark": {
    "enabled": false,
    "useLocation": true
  },
  "layers": [
    {
      "type": "image",
      "id": "main-image",
      "name": "Main image placeholder",
      "src": "",
      "frame": {
        "x": 80,
        "y": 210,
        "width": 920,
        "height": 640
      },
      "crop": {
        "x": 0,
        "y": 0,
        "zoom": 1
      },
      "opacity": 1,
      "radius": 24,
      "shadow": true
    },
    {
      "type": "text",
      "id": "top-caption",
      "text": "TOP TEXT",
      "frame": {
        "x": 70,
        "y": 56,
        "width": 940,
        "height": 140
      },
      "fontSize": 84,
      "fontWeight": 900,
      "color": "#ffffff",
      "stroke": "#111827",
      "strokeWidth": 7,
      "textShadow": true,
      "align": "center",
      "background": "transparent",
      "opacity": 1,
      "radius": 12,
      "shadow": false
    },
    {
      "type": "text",
      "id": "bottom-caption",
      "text": "BOTTOM TEXT",
      "frame": {
        "x": 70,
        "y": 884,
        "width": 940,
        "height": 140
      },
      "fontSize": 84,
      "fontWeight": 900,
      "color": "#ffffff",
      "stroke": "#111827",
      "strokeWidth": 7,
      "textShadow": true,
      "align": "center",
      "background": "transparent",
      "opacity": 1,
      "radius": 12,
      "shadow": false
    }
  ]
}
