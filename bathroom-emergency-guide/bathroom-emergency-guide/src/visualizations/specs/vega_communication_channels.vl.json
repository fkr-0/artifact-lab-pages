{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": 760,
  "height": 360,
  "padding": 18,
  "data": {
    "name": "table"
  },
  "mark": {
    "type": "line",
    "point": {
      "filled": true,
      "size": 130,
      "shape": "diamond",
      "stroke": "#172033",
      "strokeWidth": 1
    },
    "strokeWidth": 4,
    "color": "#16794a"
  },
  "encoding": {
    "x": {
      "field": "group_size",
      "type": "quantitative",
      "scale": {
        "type": "log",
        "domain": [
          2,
          110
        ]
      },
      "axis": {
        "title": "People in group (log scale)",
        "values": [
          2,
          3,
          5,
          10,
          20,
          50,
          100
        ],
        "format": ".0f"
      }
    },
    "y": {
      "field": "channels",
      "type": "quantitative",
      "scale": {
        "type": "log",
        "domain": [
          1,
          6000
        ]
      },
      "axis": {
        "title": "Possible pairwise channels (log scale)",
        "values": [
          1,
          3,
          10,
          45,
          190,
          1225,
          4950
        ],
        "format": ","
      }
    },
    "order": {
      "field": "group_size"
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "point": {
          "filled": true,
          "size": 130,
          "shape": "diamond",
          "stroke": "#172033",
          "strokeWidth": 1
        },
        "strokeWidth": 4,
        "color": "#16794a"
      }
    },
    {
      "mark": {
        "type": "text",
        "dy": -13,
        "fontWeight": "bold",
        "fontSize": 12
      },
      "encoding": {
        "text": {
          "field": "channel_label"
        }
      }
    }
  ]
}
