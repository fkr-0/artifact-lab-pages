{
  "name": "bathroom-emergency-guide-v4-alt",
  "private": true,
  "version": "0.1.0",
  "description": "Modular bathroom emergency guide — hub + subguide architecture with full PDF output.",
  "type": "module",
  "scripts": {
    "build": "./bin/build_all.sh",
    "build:diagrams": "python3 -m src.diagrams.generate_all build/diagrams",
    "build:combined": "python3 bin/build_guide.py --target all",
    "build:combined:html": "python3 bin/build_guide.py --target html",
    "build:combined:pdf": "python3 bin/build_guide.py --target pdf --layout all",
    "build:calm": "python3 bin/build_guide.py --subguide calm --target all",
    "build:ambulance": "python3 bin/build_guide.py --subguide ambulance --target all",
    "build:responsibility": "python3 bin/build_guide.py --subguide responsibility --target all",
    "build:safety": "python3 bin/build_guide.py --subguide safety --target all",
    "build:zombie": "python3 bin/build_guide.py --subguide zombie --target all",
    "build:support": "python3 bin/build_guide.py --subguide support --target all",
    "build:appendix": "python3 bin/build_guide.py --subguide appendix --target all",
    "build:body": "python3 bin/build_guide.py --subguide body --target all",
    "build:social": "python3 bin/build_guide.py --subguide social --target all",
    "build:disaster": "python3 bin/build_guide.py --subguide disaster --target all",
    "test": "python3 -m pytest tests/ -v"
  },
  "devDependencies": {
    "playwright": "^1.54.0"
  }
}
