{
  "name": "canvas-studio",
  "private": true,
  "version": "0.0.2",
  "type": "module",
  "description": "Infinite canvas for arranging, slicing, cropping and resizing images and short text blocks. Client-side only.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "node tests/run-tests.mjs",
    "preview": "vite preview",
    "lint": "biome check src",
    "format": "biome format --write src",
    "check": "biome check src"
  },
  "dependencies": {
    "@mantine/core": "^7.13.4",
    "@mantine/hooks": "^7.13.4",
    "@mantine/modals": "^7.13.4",
    "@mantine/notifications": "^7.13.4",
    "@types/d3-transition": "^3.0.9",
    "d3-selection": "^3.0.0",
    "d3-transition": "^3.0.1",
    "d3-zoom": "^3.0.0",
    "lodash-es": "^4.17.21",
    "nanoid": "^5.0.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/d3-selection": "^3.0.10",
    "@types/d3-zoom": "^3.0.8",
    "@types/lodash-es": "^4.17.12",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "packageManager": "pnpm@9.12.2"
}
